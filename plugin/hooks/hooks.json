{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-match-announcer.sh\"",
            "timeout": 5
          }
        ],
        "description": "Inject reminder: reply must start with [SkillMatch] line declaring skill scan result",
        "id": "fruity:user-prompt:skill-match-announcer"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-anti-slacking.sh\"",
            "timeout": 10
          }
        ],
        "description": "Block stop until anti-slacking-auditor sub-agent has reviewed and approved the turn",
        "id": "fruity:stop:anti-slacking"
      }
    ]
  }
}
