{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-match-announcer.sh\"",
            "timeout": 5
          }
        ],
        "description": "Inject [ACK] + [SkillMatch] mandatory header for every reply",
        "id": "fruity:user-prompt:skill-match-announcer"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-critical-redline.sh\"",
            "timeout": 5
          }
        ],
        "description": "Intercept critical red-line violations before tool execution (Co-Authored-By in commit, bind 0.0.0.0, secrets in file, systemd inline comments, dangerous rm/mkfs/dd)",
        "id": "fruity:pre-tool:critical-redline"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-mark-dirty.sh\"",
            "timeout": 3
          }
        ],
        "description": "Mark session as dirty (has code/command change) on any Write/Edit/Bash",
        "id": "fruity:post-tool:mark-dirty"
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-mark-audited.sh\"",
            "timeout": 5
          }
        ],
        "description": "Detect anti-slacking-auditor PASS verdict and mark session as audited",
        "id": "fruity:post-tool:mark-audited"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-anti-slacking.sh\"",
            "timeout": 10
          }
        ],
        "description": "Block stop until dirty session is audited PASS (uses flag files, no grep)",
        "id": "fruity:stop:anti-slacking"
      }
    ]
  }
}
